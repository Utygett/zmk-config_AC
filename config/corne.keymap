#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Layer aliases
#define DEF 0
#define NAV 1
#define SYM 2
#define NUM 3
#define ADJ 4

// Global behavior tweaks
&lt { quick-tap-ms = <175>; };
&mt { quick-tap-ms = <175>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J + K = Escape
        combo_ESC {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };

        // R + T = Backspace
        combo_BS {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp BSPC>;
        };

        // V + B = Delete
        combo_Del {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp DEL>;
        };

        // A + S = Caps Word
        combo_CAPSWORD {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // 0 — DEFAULT
        // ============================================================
        default_layer {
            bindings = <
                &kp GRAVE  &kp Q  &kp W  &kp E  &kp R  &kp T
                &kp Y      &kp U  &kp I  &kp O  &kp P  &kp LBKT

                &kp ESC    &kp A  &kp S  &kp D  &kp F  &kp G
                &kp H      &kp J  &kp K  &kp L  &kp SEMI  &kp SQT

                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B
                &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT

                &kp LALT  &mo NAV  &kp SPACE
                &kp ENTER &mo SYM  &mo NUM
            >;
        };

        // ============================================================
        // 1 — NAV
        // ============================================================
        nav_layer {
            bindings = <
                &trans  &trans  &kp HOME  &kp UP    &kp END    &kp PG_UP
                &trans  &kp LC(LS(T))  &trans  &trans  &trans  &trans

                &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN
                &trans  &kp LC(LS(V))  &kp LC(LS(C))  &trans  &trans  &trans

                &trans  &trans  &trans  &trans  &trans  &trans
                &kp INS &kp LS(INS)  &trans  &trans  &trans  &trans

                &trans  &trans  &trans
                &trans  &mo ADJ &trans
            >;
        };

        // ============================================================
        // 2 — SYM
        // ============================================================
        sym_layer {
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT    &kp LBRC  &kp RBRC  &kp STAR
                &kp CARET  &kp AMPS  &kp LT    &kp GT    &kp QMARK &kp DQT

                &trans    &kp HASH  &kp DLLR  &kp LPAR  &kp RPAR  &kp PRCNT
                &kp EQUAL &kp PLUS  &kp LBKT  &kp RBKT  &kp SEMI  &kp GRAVE

                &trans    &trans    &trans    &kp PIPE  &kp BSLH  &trans
                &kp MINUS &kp UNDER &trans    &kp DOT   &kp FSLH  &trans

                &trans  &mo ADJ  &trans
                &trans  &trans   &trans
            >;
        };

        // ============================================================
        // 3 — NUM
        // ============================================================
        num_layer {
            bindings = <
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5   &kp F6
                &kp F7  &kp F8  &kp F9  &kp F10 &kp F11  &kp F12

                &trans  &trans  &trans  &trans  &trans   &trans
                &kp PLUS &kp N7 &kp N8 &kp N9  &kp STAR &trans

                &trans  &trans  &trans  &trans  &trans   &trans
                &kp MINUS &kp N4 &kp N5 &kp N6 &trans   &trans

                &trans  &trans  &trans
                &kp N0  &kp N1  &kp N2
            >;
        };

        // ============================================================
        // 4 — ADJ
        // ============================================================
        adjust_layer {
            bindings = <
                &bootloader  &trans  &trans  &trans  &trans  &kp KP_NUM
                &trans  &trans  &trans  &trans  &trans  &bootloader

                &sys_reset
                &bt BT_SEL 0
                &bt BT_SEL 1
                &bt BT_SEL 2
                &bt BT_SEL 3
                &bt BT_SEL 4

                &bt BT_SEL 4
                &bt BT_SEL 3
                &bt BT_SEL 2
                &bt BT_SEL 1
                &bt BT_SEL 0
                &sys_reset

                &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
                &trans      &trans  &trans  &trans  &trans  &bt BT_CLR

                &trans  &trans  &trans
                &trans  &trans  &trans
            >;
        };
    };
};
