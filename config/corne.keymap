#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

// Номера слоёв
#define DEF 0
#define NAV 1
#define SYM 2
#define NUM 3
#define ADJ 4

// ----------------------------------------------------------------
// Общие настройки hold-tap
// ----------------------------------------------------------------
&lt { quick-tap-ms = <175>; };
&mt { quick-tap-ms = <175>; };

/ {
    behaviors {
        // Определение сохранено, но в текущих биндах не используется.
        // Формат: &hm МОДИФИКАТОР БУКВА
        // Например: &hm LCTRL F
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    // ----------------------------------------------------------------
    // Комбо — позиции и действия сохранены из последнего конфига.
    // ----------------------------------------------------------------
    combos {
        compatible = "zmk,combos";

        // J + K = Escape
        combo_ESC {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&kp ESC>;
        };

        // R + T = Backspace
        // Дополнительный Backspace также назначен на NAV + Y.
        combo_BS {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp BSPC>;
        };

        // V + B = Delete
        combo_Del {
            timeout-ms = <50>;
            key-positions = <28 29>;
            bindings = <&kp DEL>;
        };

        // A + S = Caps Word
        combo_CAPSWORD {
            timeout-ms = <50>;
            key-positions = <13 14>;
            bindings = <&caps_word>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ============================================================
        // 0 — DEFAULT: основной слой
        //
        // Буквы — обычные нажатия, без home-row mods.
        //
        // Нижний ряд слева направо:
        // LALT, NUM, SPACE, ENTER, NAV, SYM.
        //
        // NUM — средняя левая большая клавиша.
        // NAV — средняя правая большая клавиша.
        // SYM — крайняя правая большая клавиша.
        // ============================================================
        default_layer {
// .-----------------------------------------------.   .-----------------------------------------------.
// |  TAB  | Q / й | W / ц | E / у | R / к | T / е |   | Y / н | U / г | I / ш | O / щ | P / з | [ / х |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// | LSHFT | A / ф | S / ы | D / в | F / а | G / п |   | H / р | J / о | K / л | L / д | ; / ж | ' / э |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// | LCTRL | Z / я | X / ч | C / с | V / м | B / и |   | N / т | M / ь | , / б | . / ю | / / . | ] / ъ |
// '-----------------------+-------+-------+-------'   '-------+-------+-------+-----------------------'
//                         | LALT  |  NUM  | SPACE |   | ENTER |  NAV  |  SYM  |
//                         '-------+-------+-------'   '-------+-------+-------'
            bindings = <
  &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T      &kp Y  &kp U  &kp I      &kp O    &kp P     &kp LBKT
  &kp LSHFT    &kp A  &kp S  &kp D  &kp F  &kp G      &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
  &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B      &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RBKT
                         &kp LALT  &mo NUM  &kp SPACE      &kp ENTER  &mo NAV  &mo SYM
            >;
        };

        // ============================================================
        // 1 — NAV: навигация
        //
        // Удерживать NAV — среднюю правую большую клавишу.
        // NAV + Y / Н = Backspace.
        //
        // Для ADJ: удерживать NAV и нажать SYM
        // (крайнюю правую большую клавишу).
        //
        // Пустые клетки (&trans) пропускают действие нижнего слоя.
        // ============================================================
        nav_layer {
// .-----------------------------------------------.   .-----------------------------------------------.
// |       |       | HOME  |  UP   |  END  | PG UP |   | BSPC  | C+S+T |       |       |       |       |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |       |       | LEFT  | DOWN  | RIGHT | PG DN |   |       | C+S+V | C+S+C |       |       |       |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |       |       |       |       |       |       |   |  INS  | S+INS |       |       |       |       |
// '-----------------------+-------+-------+-------'   '-------+-------+-------+-----------------------'
//                         |       |       |       |   |       |       |  ADJ  |
//                         '-------+-------+-------'   '-------+-------+-------'
            bindings = <
  &trans  &trans     &kp HOME  &kp UP    &kp END    &kp PG_UP      &kp BSPC  &kp LC(LS(T))  &trans         &trans  &trans  &trans
  &trans  &trans     &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN      &trans    &kp LC(LS(V))  &kp LC(LS(C))  &trans  &trans  &trans
  &trans  &trans     &trans    &trans    &trans     &trans         &kp INS   &kp LS(INS)    &trans         &trans  &trans  &trans
                               &trans    &trans     &trans         &trans    &trans         &mo ADJ
            >;
        };

        // ============================================================
        // 2 — SYM: символы
        //
        // Удерживать SYM — крайнюю правую большую клавишу.
        //
        // Для ADJ: удерживать SYM и нажать NAV
        // (среднюю правую большую клавишу).
        //
        // На схеме символы для английской раскладки ОС.
        // PIPE = вертикальная черта, BSLH = обратная косая черта.
        // ============================================================
        sym_layer {
// .-----------------------------------------------.   .-----------------------------------------------.
// |   ~   |   !   |   @   |   {   |   }   |   *   |   |   ^   |   &   |   <   |   >   |   ?   |   "   |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// | ` / ё |   #   |   $   |   (   |   )   |   %   |   |   =   |   +   |   [   |   ]   |   ;   |   `   |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |       |       |       | PIPE  | BSLH  |       |   |   -   |   _   |       |   .   |   /   |       |
// '-----------------------+-------+-------+-------'   '-------+-------+-------+-----------------------'
//                         |       |       |       |   |       |  ADJ  |       |
//                         '-------+-------+-------'   '-------+-------+-------'
            bindings = <
  &kp TILDE  &kp EXCL  &kp AT    &kp LBRC  &kp RBRC  &kp STAR       &kp CARET  &kp AMPS   &kp LT     &kp GT    &kp QMARK  &kp DQT
  &kp GRAVE  &kp HASH  &kp DLLR  &kp LPAR  &kp RPAR  &kp PRCNT      &kp EQUAL  &kp PLUS   &kp LBKT   &kp RBKT  &kp SEMI   &kp GRAVE
  &trans     &trans    &trans    &kp PIPE  &kp BSLH  &trans         &kp MINUS  &kp UNDER  &trans     &kp DOT   &kp FSLH   &trans
                                 &trans    &trans    &trans         &trans     &mo ADJ    &trans
            >;
        };

        // ============================================================
        // 3 — NUM: F-клавиши слева, цифровой блок справа
        //
        // Удерживать NUM — среднюю левую большую клавишу.
        //
        // U = 7, I = 8, O = 9
        // J = 4, K = 5, L = 6
        // M = 1, COMMA = 2, DOT = 3
        // ENTER = 0
        //
        // Операторы сохранены на прежних физических позициях:
        // H = плюс, N = минус, SEMI = умножение.
        // ============================================================
        num_layer {
// .-----------------------------------------------.   .-----------------------------------------------.
// |  F1   |  F2   |  F3   |  F4   |  F5   |  F6   |   |       |   7   |   8   |   9   |       |       |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |  F7   |  F8   |  F9   |  F10  |  F11  |  F12  |   |   +   |   4   |   5   |   6   |   *   |       |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |       |       |       |       |       |       |   |   -   |   1   |   2   |   3   |       |       |
// '-----------------------+-------+-------+-------'   '-------+-------+-------+-----------------------'
//                         |       |       |       |   |   0   |       |       |
//                         '-------+-------+-------'   '-------+-------+-------'
            bindings = <
  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6       &trans     &kp N7  &kp N8  &kp N9  &trans    &trans
  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12      &kp PLUS   &kp N4  &kp N5  &kp N6  &kp STAR  &trans
  &trans  &trans  &trans  &trans   &trans   &trans        &kp MINUS  &kp N1  &kp N2  &kp N3  &trans    &trans
                          &trans   &trans   &trans        &kp N0     &trans  &trans
            >;
        };

        // ============================================================
        // 4 — ADJ: Bluetooth и обслуживание
        //
        // Как открыть:
        // 1. Зажать NAV — среднюю правую большую клавишу.
        // 2. Не отпуская NAV, зажать SYM — крайнюю правую.
        //
        // BT1..BT5 — выбор Bluetooth-профиля.
        // BT CLR — очистка сопряжения выбранного профиля.
        //
        // NAV + SYM + A / Ф = выбрать первый профиль.
        // NAV + SYM + левый Shift = очистить выбранный профиль.
        //
        // BOOT  — загрузчик для прошивки.
        // RESET — перезагрузка контроллера.
        // ============================================================
        adjust_layer {
// .-----------------------------------------------.   .-----------------------------------------------.
// | BOOT  |       |       |       |       | NUMLK |   |       |       |       |       |       | BOOT  |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// | RESET |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |   |  BT5  |  BT4  |  BT3  |  BT2  |  BT1  | RESET |
// |-------+-------+-------+-------+-------+-------|   |-------+-------+-------+-------+-------+-------|
// |BT CLR |       |       |       |       |       |   |       |       |       |       |       |BT CLR |
// '-----------------------+-------+-------+-------'   '-------+-------+-------+-----------------------'
//                         |       |       |       |   |       |       |       |
//                         '-------+-------+-------'   '-------+-------+-------'
            bindings = <
  &bootloader  &trans        &trans        &trans        &trans        &kp KP_NUM      &trans        &trans        &trans        &trans        &trans        &bootloader
  &sys_reset   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &sys_reset
  &bt BT_CLR   &trans        &trans        &trans        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &bt BT_CLR
                                           &trans        &trans        &trans          &trans        &trans        &trans
            >;
        };
    };
};
